# Copy to backend/.env and fill in. NEVER commit a filled .env to Git.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/app.db
# For PostgreSQL: postgresql://user:password@host:5432/aisystem
SECRET_KEY=change-me-to-a-long-random-string
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
MAX_REELS_PER_ACCOUNT_PER_DAY=25
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Google Drive OAuth (Phase 2) — see docs/GOOGLE_DRIVE_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/oauth/callback
# Frontend: NEXT_PUBLIC_API_URL=http://localhost:8000
