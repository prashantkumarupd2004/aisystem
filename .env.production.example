# Production environment template (Phase 9).
# Copy to .env for Docker Compose, or set these in your host's dashboard
# (Vercel / Railway / Render). NEVER commit a filled-in copy.
ENVIRONMENT=production
DATABASE_URL=postgresql://aisystem:REPLACE_ME@db:5432/aisystem
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Stable public HTTPS URL ending in /media, e.g. https://api.example.com/media
PUBLIC_MEDIA_BASE_URL=https://api.example.com/media
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
# OAuth (see docs/GOOGLE_DRIVE_SETUP.md and docs/META_SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/drive/oauth/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.example.com/api/instagram/oauth/callback
# Optional alerts (see docs/MONITORING_REPORTS.md)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
