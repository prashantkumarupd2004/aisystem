# systemd unit for the API on a Linux VPS (Phase 9).
# Install: copy to /etc/systemd/system/, edit WorkingDirectory and
# EnvironmentFile paths, then: systemctl enable --now aisystem-backend
[Unit]
Description=Instagram Reels Automation API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/aisystem/backend
EnvironmentFile=/opt/aisystem/.env
ExecStart=/opt/aisystem/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
